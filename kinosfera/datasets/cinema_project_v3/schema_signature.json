  "episode_activity": {
    "kind": "view",
    "sql": "CREATE VIEW episode_activity AS SELECT user_id,movie_id,episode_id,file_id,position,duration,watched_seconds,completed,updated_at FROM ( SELECT s.user_id,s.movie_id,s.episode_id,e.file_id, s.end_position AS position,s.duration, SUM(s.watched_seconds) OVER (PARTITION BY s.user_id,s.movie_id,s.episode_id) AS watched_seconds, MAX(s.completed) OVER (PARTITION BY s.user_id,s.movie_id,s.episode_id) AS completed, s.ended_at AS updated_at, ROW_NUMBER() OVER (PARTITION BY s.user_id,s.movie_id,s.episode_id ORDER BY s.ended_at DESC,s.id DESC) AS latest FROM watch_sessions s JOIN episodes e ON e.id=s.episode_id ) WHERE latest=1"
  },
